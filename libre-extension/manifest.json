{
  "manifest_version": 3,
  "name": "Ovis Screen Assistant (Firefox)",
  "version": "0.1.0",
  "description": "Local Ovis2.5-2B vision assistant — ask questions about the current tab. Runs against your localhost MLX daemon.",
  "permissions": ["tabs", "activeTab", "storage"],
  "browser_specific_settings": {
    "gecko": {
      "id": "ovis-screen-assistant@local.addon",
      "strict_min_version": "109.0"
    }
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "sidebar_action": {
    "default_title": "Ovis Screen Assistant",
    "default_panel": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
